<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<devices xmlns="http://schemas.android.com/sdk/devices/3"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

    <device>
        <name>Helm Head Unit 9.7"</name>
        <id>helm-head-unit-97</id>
        <manufacturer>AllWinner A133</manufacturer>
        <meta/>

        <hardware>
            <screen>
                <screen-size>xlarge</screen-size>
                <diagonal-length>9.70</diagonal-length>
                <pixel-density>mdpi</pixel-density>
                <screen-ratio>notlong</screen-ratio>
                <dimensions>
                    <x-dimension>768</x-dimension>
                    <y-dimension>1024</y-dimension>
                </dimensions>
                <xdpi>131.96</xdpi>
                <ydpi>131.96</ydpi>
                <touch>
                    <multitouch>jazz-hands</multitouch>
                    <mechanism>finger</mechanism>
                    <screen-type>capacitive</screen-type>
                </touch>
            </screen>

            <networking>
                <wifi>true</wifi>
                <bluetooth>true</bluetooth>
                <nfc>false</nfc>
            </networking>

            <sensors>
                <accelerometer>false</accelerometer>
                <barometer>false</barometer>
                <compass>false</compass>
                <gps>true</gps>
                <gyroscope>false</gyroscope>
                <light-sensor>false</light-sensor>
                <proximity-sensor>false</proximity-sensor>
            </sensors>

            <mic>true</mic>

            <camera>
                <location>back</location>
                <autofocus>false</autofocus>
                <flash>false</flash>
            </camera>

            <keyboard>nokeys</keyboard>
            <nav>nonav</nav>
            <ram unit="GiB">4</ram>
            <buttons>soft</buttons>
            <internal-storage unit="GiB">64</internal-storage>
            <removable-storage unit="GiB">0</removable-storage>
            <cpu>Generic CPU</cpu>
            <gpu>Generic GPU</gpu>

            <abi>
                <abi-type>armeabi-v7a</abi-type>
                <abi-type>x86_64</abi-type>
            </abi>

            <dock/>
            <power-type>plugged-in</power-type>
        </hardware>

        <software>
            <api-level>1-</api-level>
            <live-wallpaper-support>false</live-wallpaper-support>
            <bluetooth-profiles/>
            <gl-version>2.0</gl-version>
            <gl-extensions/>
            <status-bar>false</status-bar>
        </software>

        <state name="Portrait" default="true">
            <description>Head unit vertical display — always portrait</description>
            <screen-orientation>port</screen-orientation>
            <keyboard-state>keysexposed</keyboard-state>
            <nav-state>navexposed</nav-state>
        </state>
    </device>

</devices>
