<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<d:devices xmlns:d="http://schemas.android.com/sdk/devices/10"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <d:device>
    <d:name>Helm Head Unit 9.7"</d:name>
    <d:manufacturer>AllWinner A133</d:manufacturer>
    <d:meta/>

    <d:hardware>
      <d:screen>
        <d:screen-size>xlarge</d:screen-size>
        <d:diagonal-length>9.70</d:diagonal-length>
        <d:pixel-density>mdpi</d:pixel-density>
        <d:screen-ratio>notlong</d:screen-ratio>
        <d:dimensions>
          <d:x-dimension>768</d:x-dimension>
          <d:y-dimension>1024</d:y-dimension>
        </d:dimensions>
        <d:xdpi>131.96</d:xdpi>
        <d:ydpi>131.96</d:ydpi>
        <d:touch>
          <d:multitouch>jazz-hands</d:multitouch>
          <d:mechanism>finger</d:mechanism>
          <d:screen-type>capacitive</d:screen-type>
        </d:touch>
      </d:screen>

      <d:networking>
Bluetooth
Wifi</d:networking>

      <d:sensors>
GPS</d:sensors>

      <d:mic>true</d:mic>

      <d:camera>
        <d:location>back</d:location>
        <d:autofocus>false</d:autofocus>
        <d:flash>false</d:flash>
      </d:camera>

      <d:keyboard>nokeys</d:keyboard>
      <d:nav>nonav</d:nav>
      <d:ram unit="GiB">4</d:ram>
      <d:buttons>soft</d:buttons>
      <d:internal-storage unit="GiB">64</d:internal-storage>
      <d:removable-storage unit="GiB">0</d:removable-storage>
      <d:cpu>Generic CPU</d:cpu>
      <d:gpu>Generic GPU</d:gpu>

      <d:abi>armeabi-v7a</d:abi>
      <d:abis>armeabi-v7a</d:abis>
      <d:abis>x86_64</d:abis>

      <d:dock/>
      <d:power-type>plugged-in</d:power-type>
      <d:skin>_no_skin</d:skin>
    </d:hardware>

    <d:software>
      <d:api-level>-</d:api-level>
      <d:live-wallpaper-support>false</d:live-wallpaper-support>
      <d:bluetooth-profiles/>
      <d:gl-version>2.0</d:gl-version>
      <d:gl-extensions/>
      <d:status-bar>false</d:status-bar>
    </d:software>

    <d:state default="true" name="Portrait">
      <d:description>Head unit vertical display — always portrait</d:description>
      <d:screen-orientation>port</d:screen-orientation>
      <d:keyboard-state>keyssoft</d:keyboard-state>
      <d:nav-state>navhidden</d:nav-state>
    </d:state>

    <d:tag-id>android-automotive</d:tag-id>
  </d:device>

</d:devices>
